{
  "annotations": { "list": [] },
  "panels": [
    {
      "datasource": "Prometheus",
      "title": "CPU Usage (millicores)",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace='microservices'}[2m])) * 1000",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "Memory Usage (MiB)",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{namespace='microservices'}) / 1024 / 1024",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "title": "HTTP Request Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job='myapp'}[1m]))",
          "legendFormat": "req/s"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "version": 1,
  "title": "Microservice Dashboard"
}
